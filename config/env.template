# =============================================================================
# LLM Quant Lab - Environment Configuration (ROCm)
# =============================================================================
# Copy this file to .env in the project root and fill in ALL values.
# The application will fail to start if required variables are missing.
# =============================================================================

# -----------------------------------------------------------------------------
# Hardware Profile (cuda or rocm) - selects Docker images/overlays
# -----------------------------------------------------------------------------
HARDWARE_PROFILE=rocm

# -----------------------------------------------------------------------------
# GPU Configuration
# -----------------------------------------------------------------------------

# ROCm (AMD GPUs)
# HIP_VISIBLE_DEVICES: Comma-separated list of GPU indices (REQUIRED for ROCm)
# Example: "0" for single GPU, "0,1" for multiple GPUs
# Run `rocm-smi` to see available GPUs
HIP_VISIBLE_DEVICES=

# HSA_OVERRIDE_GFX_VERSION: Override GPU architecture (optional)
# Only needed if your GPU isn't directly supported
# Example: "10.3.0" for some RDNA2 GPUs
HSA_OVERRIDE_GFX_VERSION=

# PYTORCH_ROCM_ARCH: PyTorch ROCm architecture (optional)
# Example: "gfx1030" for RX 6800/6900
PYTORCH_ROCM_ARCH=

# CUDA (NVIDIA GPUs)
# NVIDIA_VISIBLE_DEVICES: Which GPUs to expose (REQUIRED for CUDA)
# Example: "all" for all GPUs, "0,1" for specific GPUs
NVIDIA_VISIBLE_DEVICES=all

# CUDA_VISIBLE_DEVICES: Fine-grained GPU selection (optional)
CUDA_VISIBLE_DEVICES=

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# POSTGRES_HOST: Database hostname (REQUIRED)
POSTGRES_HOST=

# POSTGRES_PORT: Database port (REQUIRED)
POSTGRES_PORT=

# POSTGRES_USER: Database username (REQUIRED)
POSTGRES_USER=

# POSTGRES_PASSWORD: Database password (REQUIRED - use a strong password!)
POSTGRES_PASSWORD=

# POSTGRES_DB: Database name (REQUIRED)
POSTGRES_DB=

# DATABASE_URL: Full PostgreSQL connection string (auto-constructed if blank)
# If left empty, it is built from the POSTGRES_* variables above.
# Example: postgresql://llmquant:password@db:5432/experiments
DATABASE_URL=

# -----------------------------------------------------------------------------
# HuggingFace Configuration
# -----------------------------------------------------------------------------
# HF_TOKEN: HuggingFace API token for gated models (REQUIRED)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# -----------------------------------------------------------------------------
# Scientist LLM Configuration (for AI-generated reports)
# -----------------------------------------------------------------------------
# SCIENTIST_LLM_PROVIDER: "openai", "anthropic", "local", or "openrouter" (REQUIRED)
SCIENTIST_LLM_PROVIDER=

# SCIENTIST_LLM_BASE_URL: API endpoint (REQUIRED)
# OpenAI: https://api.openai.com/v1
# Anthropic: https://api.anthropic.com
# Local: http://localhost:8000/v1
# OpenRouter: https://openrouter.ai/api/v1
SCIENTIST_LLM_BASE_URL=

# SCIENTIST_LLM_API_KEY: API key for the LLM provider (REQUIRED)
SCIENTIST_LLM_API_KEY=

# SCIENTIST_LLM_MODEL: Model name (REQUIRED)
# Examples: gpt-4-turbo, claude-3-opus-20240229, mistralai/Mistral-7B-Instruct-v0.2
SCIENTIST_LLM_MODEL=

# SCIENTIST_LLM_TIMEOUT: Request timeout in seconds (REQUIRED)
SCIENTIST_LLM_TIMEOUT=

# -----------------------------------------------------------------------------
# Local Directory Paths (relative to project root)
# -----------------------------------------------------------------------------
# All cache and data files are stored as subdirectories of the project

# LOCAL_MODELS_DIR: Directory for model weights and checkpoints
LOCAL_MODELS_DIR=.local/models

# LOCAL_DATA_DIR: Directory for datasets and calibration data
LOCAL_DATA_DIR=.local/data

# LOCAL_CACHE_DIR: Directory for HuggingFace and other caches
LOCAL_CACHE_DIR=.local/cache

# LOCAL_REPORTS_DIR: Directory for generated reports
LOCAL_REPORTS_DIR=reports

# LOCAL_OUTPUTS_DIR: Directory for quantized model outputs
LOCAL_OUTPUTS_DIR=outputs

# -----------------------------------------------------------------------------
# Docker Service Ports
# -----------------------------------------------------------------------------
# API_PORT: FastAPI backend port (REQUIRED)
API_PORT=

# FRONTEND_PORT: Frontend web UI port (REQUIRED)
FRONTEND_PORT=

# JUPYTER_PORT: JupyterLab port for notebook development (default: 8888)
JUPYTER_PORT=8888

# VLLM_PORT: vLLM inference server port (optional, for vllm profile)
VLLM_PORT=

# PGADMIN_PORT: pgAdmin web UI port (optional, for admin profile)
PGADMIN_PORT=

# -----------------------------------------------------------------------------
# Docker Build Configuration
# -----------------------------------------------------------------------------
# BASE_IMAGE: ROCm PyTorch base image (REQUIRED)
# Recommended: rocm/pytorch:rocm7.1_ubuntu24.04_py3.13_pytorch_release_2.9.1
BASE_IMAGE=rocm/pytorch:rocm7.1_ubuntu24.04_py3.13_pytorch_release_2.9.1

# -----------------------------------------------------------------------------
# vLLM Configuration (optional, for vllm profile)
# -----------------------------------------------------------------------------
# VLLM_MODEL: Path to quantized model for vLLM serving
VLLM_MODEL=

# -----------------------------------------------------------------------------
# pgAdmin Configuration (optional, for admin profile)
# -----------------------------------------------------------------------------
# PGADMIN_EMAIL: pgAdmin login email
PGADMIN_EMAIL=

# PGADMIN_PASSWORD: pgAdmin login password
PGADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# LOG_LEVEL: Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# LOG_FORMAT: Log format (json or text)
LOG_FORMAT=text
