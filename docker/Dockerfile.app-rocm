# =============================================================================
# LLM Quant Lab - Unified Application + API Container (ROCm)
# =============================================================================
# Based on the rocm-dev proven configuration.
# Uses the ROCm PyTorch base image which ships with torch, transformers,
# datasets, accelerate, numpy, etc. pre-installed. We only pip-install
# the additional packages the project needs.
# =============================================================================

ARG BASE_IMAGE=rocm/pytorch:rocm7.2_ubuntu22.04_py3.10_pytorch_release_2.9.1
FROM ${BASE_IMAGE}

WORKDIR /workspace

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    git vim htop tmux curl wget zip unzip cmake \
    build-essential ninja-build \
    libpq-dev libsndfile1 ffmpeg libsm6 libxext6 \
    libibverbs-dev ca-certificates iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Project dependencies not already in the base image.
# The base image provides: torch, transformers, datasets, accelerate,
# numpy, pillow, scipy, etc. We only add what's missing.
RUN pip install --no-cache-dir \
    fastapi "uvicorn[standard]" \
    sqlalchemy psycopg2-binary alembic \
    pydantic pydantic-settings \
    httpx python-dotenv pyyaml \
    huggingface_hub \
    typer rich \
    pandas matplotlib seaborn plotly kaleido \
    easydict omegaconf \
    wandb \
    jupyterlab ipywidgets ipykernel \
    sentencepiece protobuf \
    scikit-learn \
    tqdm \
    texttable toml func_timeout \
    lm-eval \
    nbformat

# Application code is bind-mounted at runtime via docker-compose volumes.
# These COPYs are only used when running without a bind mount (e.g. CI).
COPY src/ ./src/
COPY papers/ ./papers/

RUN mkdir -p /workspace/.local/models /workspace/.local/data \
    /workspace/.local/cache /workspace/reports /workspace/outputs

ENV PYTHONPATH="/workspace/vendors/lightcompress:/workspace" \
    HF_HOME="/workspace/.local/cache" \
    TRANSFORMERS_CACHE="/workspace/.local/cache" \
    HF_DATASETS_CACHE="/workspace/.local/data"

RUN rm -rf /root/.cache/pip /tmp/*

EXPOSE 8080 8888

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:8080/api/health || exit 1

CMD ["uvicorn", "src.api.server:app", "--host", "0.0.0.0", "--port", "8080"]
