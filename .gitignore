# =============================================================================
# LLM Quant Lab - Git Ignore
# =============================================================================

# -----------------------------------------------------------------------------
# Local directories (project-local cache, models, data)
# -----------------------------------------------------------------------------
.local/
postgres_data/
postgres_data_*/
outputs/
# CUDA paired-hardware arm (NVIDIA): generated venv, env file, caches, results.
# Bulky logs/rows/json stay local; the summary CSV is re-included below the
# global *.csv rule.
.venv-cuda-arm/
.cuda-arm.env
hf-cache/
reports/cuda_arm/*
# vendors/ – LightCompress is vendored and tracked
# Reports (generated, but keep directory structure)
reports/*.md
reports/*.html
reports/*.pdf
reports/*.png
reports/*.json
!reports/.gitkeep

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/

# -----------------------------------------------------------------------------
